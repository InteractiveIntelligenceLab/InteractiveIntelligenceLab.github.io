# Copy this file to .env for local development. Never commit the real .env file.
# All of these are OPTIONAL for local development — every sync script falls back
# to deterministic fixture/sample data when a value is missing. See README.md
# ("Google setup" and "Publications" sections) for how to obtain real values.

# --- Google people sync (scripts/sync-people.ts) ---------------------------
# Full JSON key of a Google service account with read-only access to the
# people Sheet and the Drive photo folder, as a single-line string.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The Google Sheet ID (from its URL) that the admin Form writes rows into.
GOOGLE_SHEET_ID=
# The Google Drive folder ID that the admin Form uploads photos into.
GOOGLE_DRIVE_FOLDER_ID=

# --- Public Google Sheet people sync (no Cloud project required) -----------
# Publish a website-only roster tab as CSV, then set its Sheet ID and tab GID.
# These are public identifiers, not secrets. If set, this mode takes priority
# over the service-account configuration above.
PUBLIC_GOOGLE_SHEET_ID=
PUBLIC_GOOGLE_SHEET_GID=0

# --- Publications sync (scripts/sync-publications.ts) -----------------------
# Optional. A free OpenAlex API key raises polite-pool rate limits. The
# OpenAlex API works without a key for this project's low request volume.
OPENALEX_API_KEY=
# Optional. Sent as the OpenAlex "mailto" polite-pool parameter.
OPENALEX_MAILTO=

# --- News sync (scripts/sync-news.ts) ---------------------------------------
# No credentials required — Google News RSS is public. Nothing to set here.

# --- Preview / staging protection (see README "Preview protection") --------
# When PREVIEW_PROTECTED=true, the deploy workflow encrypts dist/ with
# staticrypt using PREVIEW_PASSWORD. Both are supplied only as GitHub Actions
# secrets in production — never put a real password in this file.
PREVIEW_PROTECTED=false
PREVIEW_PASSWORD=

# --- Build metadata ----------------------------------------------------------
# Populated automatically by CI (git SHA). Safe to leave blank locally.
GIT_COMMIT_SHA=
