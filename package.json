{
  "name": "iil-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Official website of the Interactive Intelligence Lab (IIL), IIT Madras.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run build:version && npm run validate:content && astro check && astro build",
    "build:no-check": "npm run build:version && npm run validate:content && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:people": "tsx scripts/sync-people.ts",
    "sync:publications": "tsx scripts/sync-publications.ts",
    "sync:news": "tsx scripts/sync-news.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "build:version": "tsx scripts/generate-build-version.ts",
    "check-links": "tsx scripts/check-links.ts",
    "sync:all": "npm run sync:people && npm run sync:publications && npm run sync:news"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.13.0",
    "fast-xml-parser": "^5.11.1",
    "googleapis": "^178.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
