---
import siteConfig from "../data/site-config.json";
import { externalAttrs } from "../lib/links";

const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-surface)]">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 md:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <span
        class="flex h-8 w-8 items-center justify-center rounded-full bg-[var(--color-accent)] font-[var(--font-display)] text-sm font-bold text-[var(--color-accent-ink)] shadow-sm"
        aria-hidden="true">IIL</span
      >
      <p class="mt-4 font-[var(--font-display)] text-lg font-semibold text-[var(--color-ink)]">
        Interactive Intelligence Lab
      </p>
      <p class="mt-2 max-w-xs text-sm leading-relaxed text-[var(--color-ink-muted)]">
        {siteConfig.address.lines.slice(1).join(", ")}
      </p>
    </div>

    <div>
      <p class="kicker">Contact</p>
      <ul class="mt-3 space-y-2 text-sm text-[var(--color-ink-muted)]">
        <li>
          <a class="link-accent" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        </li>
        <li>
          <a class="link-accent" href="/join-us">Open positions</a>
        </li>
      </ul>
    </div>

    <div>
      <p class="kicker">Institutional</p>
      <ul class="mt-3 space-y-2 text-sm text-[var(--color-ink-muted)]">
        <li>
          <a class="link-accent" href={siteConfig.links.iitm} {...externalAttrs(siteConfig.links.iitm)}>
            IIT Madras
          </a>
        </li>
        <li>
          <a class="link-accent" href={siteConfig.links.dsai} {...externalAttrs(siteConfig.links.dsai)}>
            Wadhwani School of Data Science and AI
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-[var(--color-border)]">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-5 text-xs text-[var(--color-ink-faint)] sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p>&copy; {year} Interactive Intelligence Lab, IIT Madras.</p>
      <p>Built with Astro. Content synchronized from OpenAlex, DBLP, and Google News.</p>
    </div>
  </div>
</footer>
