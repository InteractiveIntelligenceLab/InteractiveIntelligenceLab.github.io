---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The page you are looking for could not be found.">
  <div class="mx-auto max-w-xl px-4 py-24 text-center sm:px-6">
    <p class="text-sm font-medium uppercase tracking-wide text-[var(--color-accent)]">404</p>
    <h1 class="mt-3 text-2xl font-semibold">Page not found</h1>
    <p class="mt-3 text-[var(--color-ink-muted)]">
      The page you're looking for doesn't exist or may have moved.
    </p>
    <a href="/" class="btn btn-primary mt-8">Return home</a>
  </div>
</BaseLayout>
